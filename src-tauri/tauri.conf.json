{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krust",
  "version": "0.1.0",
  "identifier": "dev.krust.client",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Krust contributors",
    "copyright": "Copyright (c) 2026 Krust contributors. MIT License.",
    "shortDescription": "Krunker.io client",
    "longDescription": "An unofficial Krunker.io client built with Rust and Tauri, using the system WebView2 runtime.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/avias8/krust/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
